{
  "name": "@modulane/dev-workspace-cli",
  "version": "0.1.0",
  "description": "An interactive CLI for browsing development projects and running npm scripts.",
  "type": "module",
  "bin": {
    "dev-workspace": "./index.js"
  },
  "files": [
    "index.js",
    "lib/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "check": "node --check index.js && node --check lib/cli.js && node --check lib/config.js && node --check lib/workspace.js && node --check lib/commands.js && node --check lib/prompts.js && node --check lib/ui.js && npm test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "workspace",
    "npm-scripts",
    "project-manager",
    "terminal"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modulane/dev-workspace-cli.git"
  },
  "homepage": "https://github.com/modulane/dev-workspace-cli#readme",
  "bugs": {
    "url": "https://github.com/modulane/dev-workspace-cli/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "cross-spawn": "^7.0.6"
  }
}
